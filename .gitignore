models/
/runtime/models/
/runtime/model/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Python caches, test output, and coverage
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Generated application output and diagnostics
/_profiling/
_work/
outputs/
runs/
logs/
_logs/
cache/
caches/
.cache/
results_archive/
/成果输出/
*.log
*.tmp
*.temp
*.bak
*.swp
*.pid

# User-supplied remote-sensing/GIS data (often large or private)
data/
input/
inputs/
datasets/
validation_data/
private_data/
local_data/
/project/

# Generated GIS datasets, regardless of their location. UI image assets remain
# trackable; do not blanket-ignore PNG/JPEG/JSON used by source/resources.
*.tif
*.tiff
*.gpkg
*.gpkg-wal
*.gpkg-shm
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.geojson
*.vrt
*.npy
*.npz
*.pkl
*.pickle
*.aux.xml
*.ovr

# Historic experiment figures/audits are local; keep their usage notes only.
/docs/experiment_results/**/*
!/docs/experiment_results/**/
!/docs/experiment_results/**/README.md

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
secrets*.json
*token*.json

