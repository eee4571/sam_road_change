# Keep only directory placeholders; environments and weights stay local.
!/runtime/env/
/runtime/env/*
!/runtime/env/PLACEHOLDER
/runtime/model/*
!/runtime/model/PLACEHOLDER

# Runtime products and caches.
/gui_env/
/dist/
/build/
__pycache__/
*.py[cod]
_work/
_logs/
outputs/

# Experiments: deny by default, including unlisted formats and result reports.
# Allow source/tests, README instructions and explicitly reviewed configuration.
# Do not allow *.json or *.md globally: audit/labels/reports are local results.
/experiments/**/*
!/experiments/**/
!/experiments/**/*.py
!/experiments/**/README.md
!/experiments/image_guided_graph_refinement/config.json

# Generated/data directories stay excluded even when they contain .py snapshots
# or README.md files. Keep these AFTER the source allowlist.
/experiments/**/outputs/
/experiments/**/output/
/experiments/**/results/
/experiments/**/artifacts/
/experiments/**/runs/
/experiments/**/cache/
/experiments/**/caches/
/experiments/**/__pycache__/
/experiments/**/.*/
/experiments/**/tmp/
/experiments/**/temp/
/experiments/**/logs/
/experiments/**/data/
/experiments/**/input/
/experiments/**/inputs/
/experiments/**/datasets/
/experiments/**/annotations/
/experiments/**/labels/
/experiments/**/source_snapshot/
/experiments/**/snapshots/
/experiments/**/runtime/
/experiments/**/models/
/experiments/**/env/
/experiments/**/venv/
